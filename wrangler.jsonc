{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "redit-sample",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "./public"
	},
	// 本番の Access 設定（Issue 015 / docs/DEPLOY.md）。空のままでは JWT 検証が通らず全リクエストが 403（fail closed）。
	// AUTH_MODE / DEV_USER_EMAIL はここに書かない（.dev.vars のみ）。
	"vars": {
		"TEAM_DOMAIN": "https://if-sample.cloudflareaccess.com",
		"POLICY_AUD": "8b7a57a68fa694eb7263822fd683db38f656a24a8cfbd5c6ef5af0b22a37eaa5",
		"ALLOWED_EMAIL_DOMAIN": "accelia.net"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "redit-sample",
			"database_id": "cff03d48-9e52-49bb-b298-829ec6cdd07d",
			"migrations_dir": "migrations"
		}
	]
}
